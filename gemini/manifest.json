{
  "manifest_version": 3,
  "name": "Gemini Yada",
  "version": "1.6.0",
  "description": "Gemini 网页端三合一增强：轻量输入框内额度条、透明圆点开关、导航贴边预览、实时导航与复制增强。",
  "permissions": ["storage", "declarativeNetRequest"],
  "host_permissions": ["https://gemini.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ]
}
