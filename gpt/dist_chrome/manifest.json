{
  "manifest_version": 3,
  "name": "ChatGPT Yada",
  "version": "3.1.0",
  "description": "Complete ChatGPT Markdown copy with timestamps, official navigation hover preview, prompt library, and automatic official navigator preparation.",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "native-bootstrap-page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ]
}
