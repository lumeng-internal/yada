{
  "manifest_version": 3,
  "name": "ChatGPT Yada",
  "version": "2.0.0",
  "description": "One-click Markdown copy for the current ChatGPT conversation.",
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
