{
  "name": "chatgpt-yada",
  "version": "4.1.6",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Restores ChatGPT's native long-conversation navigator, with copy-all, prompts, and local Pro quota estimates.",
  "type": "module",
  "scripts": {
    "check": "node scripts/check.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "vitest run",
    "verify:copy": "esbuild scripts/verify-copy.ts --bundle --platform=node --format=esm --outfile=/tmp/chatgpt-yada-copy-verify.mjs && node /tmp/chatgpt-yada-copy-verify.mjs",
    "verify:gate": "node scripts/verify-gate.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.303",
    "@types/node": "^25.9.0",
    "@types/sortablejs": "1.15.8",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "sortablejs": "1.15.6"
  }
}
