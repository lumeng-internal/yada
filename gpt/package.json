{
  "name": "chatgpt-yada",
  "version": "4.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Complete ChatGPT long-thread navigation, hover preview, copy-all timestamps, prompt library, and local Pro quota estimates.",
  "type": "module",
  "scripts": {
    "check": "node scripts/check.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "candidate": "node scripts/candidate.mjs",
    "test": "vitest run",
    "verify:copy": "esbuild scripts/verify-copy.ts --bundle --platform=node --format=esm --outfile=/tmp/chatgpt-yada-copy-verify.mjs && node /tmp/chatgpt-yada-copy-verify.mjs",
    "verify:gate": "node scripts/verify-gate.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.303",
    "@types/node": "^25.9.0",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
