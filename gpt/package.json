{
  "name": "chatgpt-yada",
  "version": "4.0.0",
  "private": true,
  "description": "Complete ChatGPT long-thread navigation, hover preview, copy-all timestamps, prompt library, and local Pro quota estimates.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "vitest run",
    "verify:unit": "vitest run",
    "verify:copy": "esbuild scripts/verify-copy.ts --bundle --platform=node --format=esm --outfile=/tmp/chatgpt-yada-copy-verify.mjs && node /tmp/chatgpt-yada-copy-verify.mjs",
    "verify:features": "node scripts/verify-browser.mjs",
    "verify:gate": "node scripts/verify-gate.mjs",
    "verify": "node scripts/verify.mjs",
    "acceptance:live": "node scripts/live-acceptance.mjs",
    "release": "node scripts/pack.mjs",
    "release:official": "node scripts/release.mjs major",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.303",
    "@types/node": "^25.9.0",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
