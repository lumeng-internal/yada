{
  "name": "chatgpt-yada",
  "version": "3.0.1",
  "private": true,
  "description": "Complete ChatGPT Markdown copy with timestamps, official navigation hover preview and a local prompt library.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && cp manifest.json dist_chrome/manifest.json",
    "verify:copy": "esbuild scripts/verify-copy.ts --bundle --platform=node --format=esm --outfile=/tmp/chatgpt-yada-copy-verify.mjs && node /tmp/chatgpt-yada-copy-verify.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "verify:features": "node scripts/verify-browser.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.303",
    "@types/node": "^25.9.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
